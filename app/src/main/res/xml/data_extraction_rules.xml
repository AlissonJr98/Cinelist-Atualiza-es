<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Protege credenciais sensíveis e chaves de API contra extração não criptografada -->
        <exclude domain="sharedpref" path="CineAiPrefs.xml" />
        <exclude domain="sharedpref" path="ConfiguracoesSeguranca.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="CineAiPrefs.xml" />
        <exclude domain="sharedpref" path="ConfiguracoesSeguranca.xml" />
    </device-transfer>
</data-extraction-rules>
